        {
          "id": "id",
          "name": "Reason ID",
          "type": "Symbol",
          "required": true,
          "unique": true,
          "validations": [
            { "size": { "max": 50 } }
          ]
        },
        {
          "id": "title",
          "name": "Reason Title",
          "type": "Symbol",
          "required": true,
          "validations": [
            { "size": { "max": 100 } }
          ]
        },
        {
          "id": "icon",
          "name": "Icon",
          "type": "Symbol",
          "required": true,
          "validations": [
            { "size": { "max": 50 } }
          ]
        },
        {
          "id": "description",
          "name": "Description",
          "type": "Text",
          "required": true,
          "validations": [
            { "size": { "max": 500 } }
          ]
        },
        {
          "id": "order",
          "name": "Display Order",
          "type": "Integer",
          "required": false,
          "validations": [
            { "range": { "min": 0, "max": 99 } }
          ],
          "defaultValue": {
            "en-US": 99
          }
        }
      ]
    },
    {
      "sys": {
        "id": "socialLink",
        "type": "ContentType"
      },
      "name": "Social Link",
      "displayField": "id",
      "description": "Social media profiles and contact links",
      "fields": [
        {
          "id": "id",
          "name": "Link ID",
          "type": "Symbol",
          "required": true,
          "unique": true,
          "validations": [
            { "size": { "max": 50 } }
          ]
        },
        {
          "id": "platform",
          "name": "Platform Name",
          "type": "Symbol",
          "required": true,
          "validations": [
            { "size": { "max": 50 } }
          ]
        },
        {
          "id": "url",
          "name": "Profile URL",
          "type": "Symbol",
          "required": true,
          "validations": [
            { "regexp": { "pattern": "^(https?|ftp)://[^\\s/$.?#].[^\\s]*$" } }
          ]
        },
        {
          "id": "icon",
          "name": "Icon Name",
          "type": "Symbol",
          "required": true,
          "validations": [
            { "size": { "max": 50 } }
          ]
        },
        {
          "id": "label",
          "name": "Accessible Label",
          "type": "Symbol",
          "required": true,
          "validations": [
            { "size": { "max": 100 } }
          ]
        },
        {
          "id": "order",
          "name": "Display Order",
          "type": "Integer",
          "required": false,
          "validations": [
            { "range": { "min": 0, "max": 99 } }
          ],
          "defaultValue": {
            "en-US": 99
          }
        }
      ]
    },
    {
      "sys": {
        "id": "homepage",
        "type": "ContentType"
      },
      "name": "Homepage",
      "displayField": "title",
      "description": "Homepage hero section and featured content",
      "fields": [
        {
          "id": "title",
          "name": "Hero Title",
          "type": "Symbol",
          "required": true,
          "validations": [
            { "size": { "max": 100 } }
          ]
        },
        {
          "id": "subtitle",
          "name": "Hero Subtitle",
          "type": "Symbol",
          "required": true,
          "validations": [
            { "size": { "max": 150 } }
          ]
        },
        {
          "id": "description",
          "name": "Hero Description",
          "type": "Text",
          "required": true,
          "validations": [
            { "size": { "max": 500 } }
          ]
        },
        {
          "id": "heroImages",
          "name": "Hero Images",
          "type": "Array",
          "required": true,
          "items": {
            "type": "Link",
            "linkType": "Asset",
            "validations": [
              { "linkMimetypeGroup": ["image"] }
            ]
          },
          "validations": [
            { "size": { "min": 1, "max": 5 } }
          ]
        },
        {
          "id": "ctaButtonText",
          "name": "CTA Button Text",
          "type": "Symbol",
          "required": false,
          "validations": [
            { "size": { "max": 30 } }
          ],
          "defaultValue": {
            "en-US": "View My Work"
          }
        },
        {
          "id": "ctaButtonLink",
          "name": "CTA Button Link",
          "type": "Symbol",
          "required": false,
          "defaultValue": {
            "en-US": "#portfolio"
          }
        },
        {
          "id": "whyReasons",
          "name": "Why Choose Reasons",
          "type": "Array",
          "required": false,
          "items": {
            "type": "Link",
            "linkType": "Entry",
            "validations": [
              { "linkContentType": ["whyReason"] }
            ]
          }
        },
        {
          "id": "featuredWork",
          "name": "Featured Portfolio",
          "type": "Array",
          "required": false,
          "items": {
            "type": "Link",
            "linkType": "Entry",
            "validations": [
              { "linkContentType": ["portfolioEntry"] }
            ]
          }
        }
      ]
    },
    {
      "sys": {
        "id": "portfolioEntry",
        "type": "ContentType"
      },
      "name": "Portfolio Entry",
      "displayField": "id",
      "description": "Individual portfolio work item with images and details",
      "fields": [
        {
          "id": "id",
          "name": "Entry ID",
          "type": "Symbol",
          "required": true,
          "unique": true,
          "validations": [
            { "size": { "max": 100 } }
          ]
        },
        {
          "id": "slug",
          "name": "URL Slug",
          "type": "Symbol",
          "required": true,
          "unique": true,
          "validations": [
            { "size": { "max": 150 } }
          ]
        },
        {
          "id": "title",
          "name": "Entry Title",
          "type": "Symbol",
          "required": true,
          "validations": [
            { "size": { "max": 200 } }
          ]
        },
        {
          "id": "category",
          "name": "Category",
          "type": "Symbol",
          "required": true,
          "validations": [
            {
              "in": [
                "Festival Makeup",
                "UV Makeup",
                "Nail Art",
                "Portrait",
                "Special Effects",
                "Body Art"
              ]
            }
          ]
        },
        {
          "id": "subcategory",
          "name": "Subcategory",
          "type": "Symbol",
          "required": false,
          "validations": [
            { "size": { "max": 100 } }
          ]
        },
        {
          "id": "images",
          "name": "Images",
          "type": "Array",
          "required": true,
          "items": {
            "type": "Link",
            "linkType": "Asset",
            "validations": [
              { "linkMimetypeGroup": ["image"] }
            ]
          },
          "validations": [
            { "size": { "min": 1, "max": 20 } }
          ]
        },
        {
          "id": "location",
          "name": "Location",
          "type": "Symbol",
          "required": false,
          "validations": [
            { "size": { "max": 100 } }
          ]
        },
        {
          "id": "event",
          "name": "Event Name",
          "type": "Symbol",
          "required": false,
          "validations": [
            { "size": { "max": 150 } }
          ]
        },
        {
          "id": "date",
          "name": "Date",
          "type": "Date",
          "required": false
        },
        {
          "id": "description",
          "name": "Description",
          "type": "Text",
          "required": true,
          "validations": [
            { "size": { "max": 2000 } }
          ]
        },
        {
          "id": "excerpt",
          "name": "Excerpt",
          "type": "Text",
          "required": false,
          "validations": [
            { "size": { "max": 300 } }
          ]
        },
        {
          "id": "tags",
          "name": "Tags",
          "type": "Array",
          "required": false,
          "items": {
            "type": "Symbol",
            "validations": [
              { "size": { "max": 50 } }
            ]
          },
          "validations": [
            { "size": { "max": 20 } }
          ]
        },
        {
          "id": "featured",
          "name": "Featured",
          "type": "Boolean",
          "required": false,
          "defaultValue": {
            "en-US": false
          }
        },
        {
          "id": "order",
          "name": "Display Order",
          "type": "Integer",
          "required": false,
          "validations": [
            { "range": { "min": 0, "max": 999 } }
          ],
          "defaultValue": {
            "en-US": 999
          }
        }
      ]
    },
    {
      "sys": {
        "id": "blogPost",
        "type": "ContentType"
      },
      "name": "Blog Post",
      "displayField": "id",
      "description": "Individual blog article with rich content",
      "fields": [
        {
          "id": "id",
          "name": "Post ID",
          "type": "Symbol",
          "required": true,
          "unique": true,
          "validations": [
            { "size": { "max": 100 } }
          ]
        },
        {
          "id": "slug",
          "name": "URL Slug",
          "type": "Symbol",
          "required": true,
          "unique": true,
          "validations": [
            { "size": { "max": 150 } }
          ]
        },
        {
          "id": "title",
          "name": "Post Title",
          "type": "Symbol",
          "required": true,
          "validations": [
            { "size": { "max": 200 } }
          ]
        },
        {
          "id": "excerpt",
          "name": "Excerpt",
          "type": "Text",
          "required": true,
          "validations": [
            { "size": { "max": 500 } }
          ]
        },
        {
          "id": "content",
          "name": "Post Content",
          "type": "RichText",
          "required": true,
          "validations": [
            {
              "enabledNodeTypes": [
                "heading-1",
                "heading-2",
                "heading-3",
                "heading-4",
                "heading-5",
                "heading-6",
                "ordered-list",
                "unordered-list",
                "blockquote",
                "hr",
                "hyperlink",
                "embedded-asset-block",
                "embedded-entry-block"
              ]
            }
          ]
        },
        {
          "id": "featuredImage",
          "name": "Featured Image",
          "type": "Link",
          "required": true,
          "linkType": "Asset",
          "validations": [
            { "linkMimetypeGroup": ["image"] }
          ]
        },
        {
          "id": "publishedAt",
          "name": "Published Date",
          "type": "Date",
          "required": true
        },
        {
          "id": "updatedAt",
          "name": "Last Updated",
          "type": "Date",
          "required": false
        },
        {
          "id": "category",
          "name": "Category",
          "type": "Link",
          "required": true,
          "linkType": "Entry",
          "validations": [
            { "linkContentType": ["blogCategory"] }
          ]
        },
        {
          "id": "tags",
          "name": "Tags",
          "type": "Array",
          "required": false,
          "items": {
            "type": "Symbol",
            "validations": [
              { "size": { "max": 50 } }
            ]
          },
          "validations": [
            { "size": { "max": 30 } }
          ]
        },
        {
          "id": "readTime",
          "name": "Reading Time",
          "type": "Integer",
          "required": false,
          "validations": [
            { "range": { "min": 1, "max": 60 } }
          ]
        },
        {
          "id": "featured",
          "name": "Featured Post",
          "type": "Boolean",
          "required": false,
          "defaultValue": {
            "en-US": false
          }
        }
      ]
    },
