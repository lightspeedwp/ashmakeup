{
  "contentTypes": [
    {
      "sys": {
        "id": "blogCategory",
        "type": "ContentType"
      },
      "name": "Blog Category",
      "displayField": "id",
      "description": "Category classification for blog posts",
      "fields": [
        {
          "id": "id",
          "name": "Category ID",
          "type": "Symbol",
          "required": true,
          "unique": true,
          "validations": [
            { "size": { "max": 50 } }
          ],
          "disabled": false,
          "omitted": false
        },
        {
          "id": "name",
          "name": "Category Name",
          "type": "Symbol",
          "required": true,
          "validations": [
            { "size": { "max": 100 } }
          ]
        },
        {
          "id": "slug",
          "name": "URL Slug",
          "type": "Symbol",
          "required": true,
          "unique": true,
          "validations": [
            { "size": { "max": 100 } }
          ]
        },
        {
          "id": "description",
          "name": "Description",
          "type": "Text",
          "required": false,
          "validations": [
            { "size": { "max": 300 } }
          ]
        },
        {
          "id": "color",
          "name": "Color Code",
          "type": "Symbol",
          "required": false,
          "validations": [
            { "regexp": { "pattern": "^#[0-9A-Fa-f]{6}$" } }
          ]
        },
        {
          "id": "icon",
          "name": "Icon",
          "type": "Symbol",
          "required": false,
          "validations": [
            { "size": { "max": 50 } }
          ]
        }
      ]
    },
    {
      "sys": {
        "id": "whyReason",
