{
  "name": "ash-shaw-makeup-portfolio",
  "version": "7.0.0",
  "description": "Personal art portfolio showcasing festival makeup artistry, UV neon designs, and creative expression — Neon vs Atomic Black",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir dist",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "verify": "ts-node scripts/verify-build.ts",
    "optimize-images": "ts-node scripts/optimize-images.ts"
  },
  "keywords": [
    "makeup",
    "portfolio",
    "artist",
    "festival",
    "UV makeup",
    "creative",
    "berlin",
    "psytrance",
    "neon",
    "personal art project"
  ],
  "author": "Ash Shaw",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "0.475.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/node": "^20.12.0",
    "ts-node": "^10.9.2",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16"
  }
}