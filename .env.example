# =============================================================================
# Ash Shaw Makeup Portfolio - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it's already in .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# CONTENTFUL CMS CONFIGURATION
# -----------------------------------------------------------------------------
# Get these values from: https://app.contentful.com/spaces/YOUR_SPACE/api/keys
#
# Steps to get your credentials:
# 1. Log in to Contentful at https://app.contentful.com
# 2. Select your space (or create one)
# 3. Go to Settings > API Keys
# 4. Create a new API key or use an existing one
# 5. Copy the Space ID and Content Delivery API access token

# Your Contentful Space ID (found in Settings > General settings or API keys)
VITE_CONTENTFUL_SPACE_ID=your_space_id_here

# Content Delivery API access token (for published content)
VITE_CONTENTFUL_ACCESS_TOKEN=your_access_token_here

# Content Preview API access token (for draft/preview content - optional)
# This enables preview mode functionality for unpublished content
VITE_CONTENTFUL_PREVIEW_TOKEN=your_preview_token_here

# Contentful Environment (default: master)
# Only change if using multiple environments
VITE_CONTENTFUL_ENVIRONMENT=master

# -----------------------------------------------------------------------------
# NETLIFY DEPLOYMENT CONFIGURATION (Optional - for local testing)
# -----------------------------------------------------------------------------
# These are typically set in Netlify dashboard, not locally

# Netlify Site ID (found in Site settings > General)
# NETLIFY_SITE_ID=your_netlify_site_id

# Netlify Auth Token (for Netlify CLI and webhooks)
# NETLIFY_AUTH_TOKEN=your_netlify_auth_token

# -----------------------------------------------------------------------------
# SENDGRID EMAIL SERVICE (Optional)
# -----------------------------------------------------------------------------
# For contact form functionality

# VITE_SENDGRID_API_KEY=your_sendgrid_api_key
# VITE_SENDGRID_FROM_EMAIL=hello@ashshaw.com
# VITE_CONTACT_EMAIL=contact@ashshaw.com

# -----------------------------------------------------------------------------
# SUPABASE (Optional - for form submissions)
# -----------------------------------------------------------------------------
# VITE_SUPABASE_URL=your_supabase_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# -----------------------------------------------------------------------------
# ANALYTICS (Optional)
# -----------------------------------------------------------------------------
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
